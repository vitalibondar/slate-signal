#!/usr/bin/env python3
"""Verify Slate Signal (or any Omarchy colors.toml) against the readability
targets in the design brief. Computes WCAG 2.x relative-luminance ratios on the
literal sRGB hex values (display-independent) and prints a PASS/WARN/FAIL table.

Usage:  omarchy-contrast-check path/to/colors.toml
Exits non-zero if any pair FAILS its hard floor.

Targets:  primary small text >= 7.0 (WARN below), hard floor 4.5 (FAIL below),
          non-text UI boundaries >= 3.0 (WARN below 3, FAIL below 2)."""
import sys, re

def parse(path):
    c = {}
    for line in open(path):
        m = re.match(r'\s*([a-z_]+)\s*=\s*"?(#[0-9a-fA-F]{6}|light|dark)"?', line)
        if m: c[m.group(1)] = m.group(2)
    return c

def lin(v):
    v /= 255.0
    return v/12.92 if v <= 0.03928 else ((v+0.055)/1.055)**2.4

def L(h):
    n = int(h[1:], 16)
    return 0.2126*lin(n>>16&255) + 0.7152*lin(n>>8&255) + 0.0722*lin(n&255)

def ratio(a, b):
    la, lb = L(a), L(b)
    return (max(la, lb)+0.05) / (min(la, lb)+0.05)

def derive_selection_fg(c):
    """Mirror the real rule in omarchy-theme-color (Omarchy 4.0.2, verified
    2026-09-03 on /usr/bin/omarchy-theme-color ~line 231): an explicit
    selection_foreground in colors.toml wins; otherwise it is simply
    bright_foreground (which itself falls back to color15, then foreground).
    There is NO contrast-picking in theme-set."""
    return (c.get("selection_foreground")
            or c.get("bright_foreground")
            or c.get("color15")
            or c["foreground"])

def main():
    if len(sys.argv) < 2:
        print("usage: omarchy-contrast-check colors.toml"); sys.exit(2)
    c = parse(sys.argv[1])
    sel_fg = derive_selection_fg(c)
    # (label, fg, bg, target, floor, kind)
    checks = [
        ("body / background",        c["foreground"],        c["background"],        7.0, 4.5, "text"),
        ("body / surface",           c["foreground"],        c["lighter_background"],7.0, 4.5, "text"),
        ("muted / background",       c["muted"],             c["background"],        7.0, 4.5, "text"),
        ("muted / surface",          c["muted"],             c["lighter_background"],7.0, 4.5, "text"),
        ("bright / background",      c["bright_foreground"], c["background"],        7.0, 4.5, "text"),
        ("accent / background",      c["accent"],            c["background"],        4.5, 3.0, "text"),
        ("selection fg / band",      sel_fg,                 c["selection"],         7.0, 4.5, "text"),
        ("red / background",         c["red"],               c["background"],        4.5, 3.0, "text"),
        ("yellow / background",      c["yellow"],            c["background"],        4.5, 3.0, "text"),
        ("green / background",       c["green"],             c["background"],        4.5, 3.0, "text"),
        ("cyan / background",        c["cyan"],              c["background"],        4.5, 3.0, "text"),
        ("blue / background",        c["blue"],              c["background"],        4.5, 3.0, "text"),
        ("magenta / background",     c["magenta"],           c["background"],        4.5, 3.0, "text"),
        ("selection band / bg",      c["selection"],         c["background"],        3.0, 1.5, "ui"),
        ("surface / background",     c["lighter_background"],c["background"],        1.1, 1.03,"ui"),
    ]
    worst = 0.0; fails = 0
    print(f"\n  {c.get('mode','?').upper():5}  {sys.argv[1]}")
    print(f"  {'pair':24} {'ratio':>7}  status")
    print("  " + "-"*44)
    for label, fg, bg, target, floor, kind in checks:
        r = ratio(fg, bg)
        if r >= target: status = "PASS"
        elif r >= floor: status = "WARN"
        else: status = "FAIL"; fails += 1
        print(f"  {label:24} {r:7.2f}  {status}" + ("" if status=="PASS" else f"  (target {target})"))
    print(f"\n  selection_foreground derived as {sel_fg}")
    print(f"  {fails} FAIL\n")
    sys.exit(1 if fails else 0)

if __name__ == "__main__":
    main()
